<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- ダウンロードした動画データおよび一時キャッシュはクラウドバックアップ対象から除外 -->
        <exclude domain="file" path="downloads" />
        <exclude domain="cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads" />
        <exclude domain="cache" />
    </device-transfer>
</data-extraction-rules>
