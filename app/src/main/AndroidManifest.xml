<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HycoHycoApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 1. ニコニコ動画 / ユーザー / マイリスト / シリーズ Deep Link (nicovideo.jp, sp.nicovideo.jp) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="nicovideo.jp" />
                <data android:host="www.nicovideo.jp" />
                <data android:host="sp.nicovideo.jp" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/shorts" />
                <data android:pathPrefix="/user" />
                <data android:pathPrefix="/mylist" />
                <data android:pathPrefix="/series" />
            </intent-filter>

            <!-- 2. 短縮 URL Deep Link (nico.ms) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="nico.ms" />
            </intent-filter>

            <!-- 3. 他アプリからのテキスト共有受け取り -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.service.HycoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".data.download.OfflineDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ホーム画面再生コントローラー AppWidget -->
        <receiver
            android:name=".ui.widget.HycoPlayerWidgetReceiver"
            android:label="@string/hyco_player_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.github.stm7128.hycohyco.widget.ACTION_TOGGLE_PLAY_PAUSE" />
                <action android:name="com.github.stm7128.hycohyco.widget.ACTION_SEEK_BACKWARD" />
                <action android:name="com.github.stm7128.hycohyco.widget.ACTION_SEEK_FORWARD" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hyco_player_widget_info" />
        </receiver>
    </application>

</manifest>
